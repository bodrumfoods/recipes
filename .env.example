# Auth.js (NextAuth) — required for "Sign in with Google", My Favourites, and Meal Plan History.
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials — create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials
#   - Application type: Web application
#   - Authorized redirect URI: https://<your-domain>/api/auth/callback/google
#     (and http://localhost:3000/api/auth/callback/google for local dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shopify storefront domain used to build cart/product links.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=bodrumfoods.co.uk

# Resend — required to email job applications to your recruitment inbox and to send
# applicants a confirmation email. Get an API key at https://resend.com/api-keys after
# verifying a sending domain (e.g. bodrumfoods.co.uk) at https://resend.com/domains.
RESEND_API_KEY=
# Where new applications are sent. Defaults to hello@bodrumfoods.co.uk if unset.
CAREERS_NOTIFICATION_EMAIL=hello@bodrumfoods.co.uk
# Must be an address on your verified Resend sending domain.
CAREERS_FROM_EMAIL="Bodrum Foods Careers <careers@bodrumfoods.co.uk>"
